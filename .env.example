# Copy this file to .env and replace only the OAuth values with real credentials.
# .env is ignored by Git and is loaded by both Spring Boot and Docker Compose.

POSTGRES_DB=dodamdodam
POSTGRES_USER=dodamdodam
POSTGRES_PASSWORD=dodamdodam_local
POSTGRES_PORT=5432

SERVER_PORT=8080
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
KAKAO_CLIENT_ID=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret

APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_LOGIN_SUCCESS_URL=http://localhost:5173/oauth/callback
APP_LOGOUT_SUCCESS_URL=http://localhost:5173
SESSION_COOKIE_SECURE=false
