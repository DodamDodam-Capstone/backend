# Copy this file to .env and provide the required OAuth and conversation settings.
# .env is ignored by Git and is loaded by both Spring Boot and Docker Compose.

POSTGRES_DB=dodamdodam
POSTGRES_USER=dodamdodam
POSTGRES_PASSWORD=dodamdodam_local
POSTGRES_PORT=5432

SERVER_PORT=8080
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
KAKAO_CLIENT_ID=replace-with-kakao-rest-api-key
KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret

APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_LOGIN_SUCCESS_URL=http://localhost:5173/oauth/callback
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# 양의 Duration을 명시해야 하며 D13/D14 미확정 수치를 운영 기본값으로 넣지 않는다.
SUMMARY_PROCESSING_TIMEOUT=

# 서로 다른 raw 32바이트 파일. 값 자체를 환경변수·Git·로그에 넣지 않는다.
AUTH_RATE_LIMIT_KEY_FILE=.secrets/rate-limit.key
EMAIL_CODE_KEY_FILE=.secrets/email-code.key
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD_FILE=.secrets/smtp-password
SMTP_TIMEOUT_MS=5000
SMTP_STARTTLS=true
SMTP_SSL=false
